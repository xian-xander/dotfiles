#!/bin/bash
printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' >/dev/null 2>&1

tput civis
clear

exit_screensaver() {
  ~/.local/bin/kill-screensaver.sh
}

trap exit_screensaver EXIT SIGINT SIGTERM SIGHUP

seed=${1:-$RANDOM}

while true; do
  ~/.local/bin/tte --input-file ~/.config/omarchy/branding/arch.txt \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 \
    --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --seed $seed --no-eol --no-restore-cursor &
    
  tte_pid=$!
  
  while kill -0 $tte_pid 2>/dev/null; do
    if read -n1 -t 0.5; then
      exit_screensaver
    fi
  done
  
  # Change seed for the next iteration so they all stay synced on the next random effect
  seed=$((seed + 1))
done
