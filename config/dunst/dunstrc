[global]
    monitor = 0
    follow = mouse
    
    width = 300
    height = 300
    origin = top-right
    offset = 20x20
    
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    
    indicate_hidden = yes
    shrink = no
    
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 12
    
    # Waybar modules use a border radius of 15px
    corner_radius = 15
    
    # No border in waybar, or we can use a subtle one
    frame_width = 2
    frame_color = "#313134"
    separator_color = frame
    
    sort = yes
    idle_threshold = 120
    
    font = Fira Sans Semibold 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    enable_icon = true
    icon_theme = "breeze-dark, Adwaita"
    
    sticky_history = yes
    history_length = 20
    
    always_run_script = true
    
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#000008B3"
    foreground = "#c0caf5"
    frame_color = "#313134"
    timeout = 5

[urgency_normal]
    background = "#000008B3"
    foreground = "#c0caf5"
    frame_color = "#313134"
    timeout = 10

[urgency_critical]
    background = "#11111bB3"
    foreground = "#ff7a93"
    frame_color = "#ff7a93"
    timeout = 0
